# ===== OLYMPUS ACADEMY Whitelist — คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่า =====

# URL ของเว็บ (ตอนพัฒนาใช้ localhost, ตอนขึ้นจริงเปลี่ยนเป็นโดเมน https://...)
APP_URL=http://localhost:3000

# สุ่มข้อความยาว ๆ อย่างน้อย 32 ตัวอักษร ใช้เซ็นคุกกี้ล็อกอิน
AUTH_SECRET=

# Discord Developer Portal → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=
# คลิกขวาที่ชื่อเซิร์ฟเวอร์ → Copy Server ID
DISCORD_GUILD_ID=

# Discord ID ของแอดมินเริ่มต้น (คั่นด้วย , ได้หลายคน)
ADMIN_DISCORD_IDS=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
